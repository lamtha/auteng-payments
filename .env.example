# AutEng Payments — Environment Config
# Copy to .env and fill in values.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (test mode)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Apple Pay: merchant ID is configured in app.json plugin config.
# The Apple Pay merchant ID must be registered in your Apple Developer account
# and associated with the Stripe account. See:
#   https://docs.stripe.com/apple-pay?platform=react-native
#
# For local webhook testing:
#   stripe listen --forward-to localhost:8000/webhooks/stripe/
