# AutEng Payments — Environment Config
# Copy to .env and fill in values.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (test mode)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Apple Sign-In: no client-side config needed — uses bundle ID from app.json.
# Backend env vars (set in be/.env):
#   APPLE_BUNDLE_ID=ai.auteng.payments
#   GOOGLE_MOBILE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
